# Copy to .env and fill in before running Phase 0's live sandbox gate or any
# model/Tavily-backed service. Nothing in this file is a real secret.

# --- Nebius Token Factory ---------------------------------------------------
# API key for Nebius AI Studio / Token Factory (inference + Sandboxes).
NEBIUS_API_KEY=
# Base URL for the Token Factory OpenAI-compatible inference endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ids actually deployed on Token Factory for each role (§4.1 task routing).
NEBIUS_MODEL_RECON=nvidia/nemotron-3-nano
NEBIUS_MODEL_PLANNER=nvidia/nemotron-3-super
NEBIUS_MODEL_REPAIRER=nvidia/nemotron-3-super
NEBIUS_MODEL_ADJUDICATOR=nvidia/nemotron-3-ultra

# --- Nebius Sandboxes / Serverless Jobs -------------------------------------
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE=python:3.11-slim
NEBIUS_SANDBOX_WALL_CLOCK_SECONDS=600

# Which backend actually executes untrusted repo code. "token_factory"
# (default) uses contree_sdk against Nebius Token Factory Sandboxes and
# NEBIUS_API_KEY/NEBIUS_PROJECT_ID above. "compute" provisions a real
# Nebius AI Cloud Compute VM per run, using the SEPARATE credential below.
# See this session's Nebius integration audit (DECISIONS.md) for why these
# are two different Nebius products with two different credentials.
NEBIUS_SANDBOX_BACKEND=token_factory

# --- Nebius AI Cloud (Compute) -----------------------------------------
# Only read when NEBIUS_SANDBOX_BACKEND=compute. Deliberately separate
# from the Token Factory key above — this is a service-account "authorized
# key" JSON file downloaded from the Nebius console (Compute uses Nebius's
# general Cloud IAM, not Token Factory's bearer key). See
# compute_sandbox.py's module docstring for the exact JSON shape and how
# it's consumed.
NEBIUS_COMPUTE_CREDENTIALS_FILE=
# The Compute project (parent id) VMs are created in — from the console,
# not the same value as NEBIUS_PROJECT_ID above.
NEBIUS_COMPUTE_PROJECT_ID=
# An existing VPC subnet id in that project — required; this module does
# not provision networking for you.
NEBIUS_COMPUTE_SUBNET_ID=
NEBIUS_COMPUTE_PLATFORM=cpu-e2
NEBIUS_COMPUTE_PRESET=4vcpu-16gb
# A real image family from your account/region (e.g. an Ubuntu family) —
# there is no working default; verify the exact string in the console.
NEBIUS_COMPUTE_IMAGE_FAMILY=
NEBIUS_COMPUTE_SSH_USERNAME=ubuntu
NEBIUS_COMPUTE_BOOT_DISK_GIB=20

# --- Tavily (runtime-cited context; Best Use of Tavily track) --------------
TAVILY_API_KEY=

# --- App -------------------------------------------------------------------
# Kept in sync with docker-compose.yml's backend-data volume (/app/data).
DATABASE_URL=sqlite:///./data/rerun.db
DEMO_MODE=false
# Hard daily ceiling enforced by cost_guard.py, not just documentation.
DAILY_COST_CEILING_USD=25
MAX_ATTEMPTS_PER_RUN=3
