# Copy to .env and fill in before running Phase 0's live sandbox gate or any
# model/Tavily-backed service. Nothing in this file is a real secret.

# --- Nebius Token Factory ---------------------------------------------------
# API key for Nebius AI Studio / Token Factory (inference + Sandboxes).
NEBIUS_API_KEY=
# Base URL for the Token Factory OpenAI-compatible inference endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ids actually deployed on Token Factory for each role (§4.1 task routing).
NEBIUS_MODEL_RECON=nvidia/nemotron-3-nano
NEBIUS_MODEL_PLANNER=nvidia/nemotron-3-super
NEBIUS_MODEL_REPAIRER=nvidia/nemotron-3-super
NEBIUS_MODEL_ADJUDICATOR=nvidia/nemotron-3-ultra

# --- Nebius Sandboxes / Serverless Jobs -------------------------------------
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE=python:3.11-slim
NEBIUS_SANDBOX_WALL_CLOCK_SECONDS=600

# --- Tavily (runtime-cited context; Best Use of Tavily track) --------------
TAVILY_API_KEY=

# --- App -------------------------------------------------------------------
# Kept in sync with docker-compose.yml's backend-data volume (/app/data).
DATABASE_URL=sqlite:///./data/rerun.db
DEMO_MODE=false
# Hard daily ceiling enforced by cost_guard.py, not just documentation.
DAILY_COST_CEILING_USD=25
MAX_ATTEMPTS_PER_RUN=3
