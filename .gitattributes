# corpus-v1 files are hashed byte-for-byte (prereg population_sha256, corpus_hash):
# never let a checkout convert their line endings (e.g. core.autocrlf=true on Windows).
backend/app/batch/corpus_v1/** -text
backend/app/batch/corpus_v2/** -text
# RERUN import-name table: byte-exact so the recorded provenance hashes hold on any checkout.
backend/app/data/import_names/** -text
