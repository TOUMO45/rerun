     USE_CUDA = False
 
 
+def _lu_nopivot(A):
+    # packed LU factorisation without pivoting (what torch.lu(A, pivot=False)[0] returns on CUDA)
+    A = A.clone()
+    for k in range(A.shape[0] - 1):
+        A[k + 1:, k] /= A[k, k]
+        A[k + 1:, k + 1:] -= torch.ger(A[k + 1:, k], A[k, k + 1:])
+    return A
+
