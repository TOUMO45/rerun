+import os
+import pickle
+
+import numpy as np
+import torchvision
+
+
+def install(root):
+    d = os.path.join(root, 'cifar-10-batches-py')
+    os.makedirs(d, exist_ok=True)
+    for name in ['data_batch_%d' % i for i in range(1, 6)] + ['test_batch']:
+        with open(os.path.join(d, name), 'wb') as f:
+            pickle.dump({'data': np.random.randint(0, 256, (10000, 3072)).astype(np.uint8),
+                         'labels': np.random.randint(0, 10, 10000).tolist()}, f)
+    with open(os.path.join(d, 'batches.meta'), 'wb') as f:
+        pickle.dump({'label_names': [str(i) for i in range(10)]}, f)
+    torchvision.datasets.CIFAR10._check_integrity = lambda self: True
