@@ -0,0 +1,13 @@
+import os
+import random
+
+
+def make(dataset, n_ent=40943, n_rel=18, sizes=None):
+    sizes = sizes or {'train': 141442, 'valid': 5000, 'test': 5000}
+    d = dataset + '_synthetic/'
+    os.makedirs(d, exist_ok=True)
+    for name, n in sizes.items():
+        with open(d + name + '.txt', 'w') as f:
+            for _ in range(n):
+                f.write('%08d\t_rel%d\t%08d\n' % (random.randrange(n_ent), random.randrange(n_rel), random.randrange(n_ent)))
+    return d
